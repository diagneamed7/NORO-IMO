<section class="hero" id="accueil">
  <div class="container">
    <div class="hero-inner">
      <p class="eyebrow">SENEGAL &amp; DIASPORA</p>
      <h1>Construisons ensemble<br>votre <span class="accent">avenir immobilier.</span></h1>
      <div class="route-divider">
        <svg viewBox="0 0 64 10"><path d="M0 8 C 18 8, 22 2, 34 2 S 54 8, 64 8" stroke="url(#g1)" stroke-width="3" fill="none" stroke-linecap="round"/><defs><linearGradient id="g1" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#0A4D9B"/><stop offset="1" stop-color="#F57C00"/></linearGradient></defs></svg>
      </div>
      <p class="lead">NORO Immobilier vous accompagne dans l'achat, la vente, la location, la construction et la gestion de votre patrimoine immobilier au Senegal — et aupres de la diaspora.</p>
      <div class="hero-ctas">
        <a href="#biens" class="btn-primary">Voir les biens</a>
        <a href="#" class="btn-ghost" onclick="openContactModal('contact');return false;">Nous contacter</a>
      </div>
    </div>
  </div>
  <div class="scroll-cue">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </div>
</section>

<div class="container">
  <div class="search-card">
    <div class="search-grid">
      <div class="field">
        <label>Type de bien</label>
        <select id="fType">
          <option value="">Tous types</option>
          <option value="Terrain">Terrain</option>
          <option value="Maison">Maison</option>
        </select>
      </div>
      <div class="field">
        <label>Localisation</label>
        <select id="fZone">
          <option value="">Toutes zones</option>
        </select>
      </div>
      <div class="field">
        <label>Transaction</label>
        <select id="fTransaction">
          <option value="">Vente cash / moratoire</option>
          <option value="cash">Vente cash</option>
          <option value="moratoire">Avec moratoire</option>
        </select>
      </div>
