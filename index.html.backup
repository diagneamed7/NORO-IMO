<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NORO Immobilier — Avec NORO Immo, l'avenir s'habite</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --blue:#0A4D9B;
    --blue-deep:#063a73;
    --blue-ink:#062a52;
    --orange:#F57C00;
    --white:#FFFFFF;
    --gray:#F5F5F5;
    --ink:#222222;
    --radius:14px;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Plus Jakarta Sans',sans-serif;
    color:var(--ink);
    background:var(--white);
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{
    font-family:'Bricolage Grotesque',sans-serif;
    font-weight:700;
    line-height:1.08;
    letter-spacing:-0.01em;
  }
  @keyframes fadeUp{from{opacity:0;transform:translateY(22px);}to{opacity:1;transform:translateY(0);}}
  @keyframes bounceDown{0%,100%{transform:translateY(0);opacity:.7;}50%{transform:translateY(10px);opacity:1;}}
  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}
  button{font-family:inherit;cursor:pointer;border:none;}
  .container{max-width:1240px;margin:0 auto;padding:0 24px;}
  .eyebrow{
    text-transform:uppercase;
    letter-spacing:0.14em;
    font-size:12.5px;
    font-weight:700;
    color:var(--blue);
  }

  .route-divider{
    width:64px;height:10px;margin:14px 0 0;
  }
  .route-divider svg{width:100%;height:100%;display:block;}
  .center .route-divider{margin-left:auto;margin-right:auto;}

  .topbar{
    background:var(--blue-ink);
    color:rgba(255,255,255,0.88);
    font-size:13px;
  }
  .topbar .container{
    display:flex;align-items:center;justify-content:space-between;
    padding:9px 24px;flex-wrap:wrap;gap:8px;
  }
  .topbar-left{display:flex;gap:18px;flex-wrap:wrap;align-items:center;}
  .topbar-left span{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;}
  .topbar-right{display:flex;align-items:center;gap:16px;}
  .socials{display:flex;gap:12px;}
  .socials a{opacity:0.85;transition:opacity .2s;}
  .socials a:hover{opacity:1;}
  .btn-quote{
    background:var(--orange);color:#fff;font-weight:600;font-size:12.5px;
    padding:7px 16px;border-radius:999px;letter-spacing:0.01em;
    transition:filter .2s;
  }
  .btn-quote:hover{filter:brightness(1.08);}

  header.main{
    background:#fff;position:sticky;top:0;z-index:50;
    box-shadow:0 1px 0 rgba(0,0,0,0.06);
  }
  header.main .container{
    display:flex;align-items:center;justify-content:space-between;
    padding:14px 24px;gap:20px;
  }
  .logo-wrap{display:flex;align-items:center;gap:10px;flex-shrink:0;}
  .logo-wrap img{height:52px;width:auto;}
  nav.main-menu{display:flex;gap:26px;flex-wrap:wrap;}
  nav.main-menu a{
    font-size:14.5px;font-weight:600;color:var(--ink);
    position:relative;padding:4px 0;transition:color .2s;
  }
  nav.main-menu a:hover{color:var(--blue);}
  nav.main-menu a::after{
    content:"";position:absolute;left:0;bottom:-2px;height:2px;width:0;
    background:var(--orange);transition:width .25s;
  }
  nav.main-menu a:hover::after{width:100%;}
  .btn-rdv{
    background:var(--blue);color:#fff;font-weight:600;font-size:14px;
    padding:11px 22px;border-radius:999px;white-space:nowrap;
    transition:filter .2s;
  }
  .btn-rdv:hover{filter:brightness(1.1);}
  .burger{display:none;background:none;font-size:26px;color:var(--blue);}

  .hero{
    position:relative;overflow:hidden;min-height:88vh;
    display:flex;flex-direction:column;justify-content:center;
    background-image:linear-gradient(180deg,rgba(10,30,60,0.72) 0%,rgba(10,40,80,0.55) 45%,rgba(6,18,36,0.85) 100%), url('https://images.unsplash.com/photo-1760473537243-72168ffd273c?fm=jpg&q=70&w=1800&auto=format&fit=crop');
    background-size:cover;background-position:center;
    padding:120px 0 150px;
  }
  .hero-inner{max-width:680px;}
  .hero .eyebrow{color:#FFD9A8;animation:fadeUp .8s ease .05s both;}
  .hero h1{font-size:clamp(34px,5.5vw,58px);color:#fff;animation:fadeUp .8s ease .15s both;}
  .hero h1 .accent{color:var(--orange);}
  .hero p.lead{
    margin-top:20px;font-size:clamp(16px,1.6vw,19px);color:#e7edf6;max-width:560px;
    animation:fadeUp .8s ease .3s both;
  }
  .hero-ctas{display:flex;gap:16px;margin-top:32px;flex-wrap:wrap;animation:fadeUp .8s ease .45s both;}
  .scroll-cue{
    position:absolute;left:50%;bottom:26px;transform:translateX(-50%);
    animation:bounceDown 2s ease-in-out infinite;color:#fff;
  }
  .btn-primary{
    background:var(--orange);color:#fff;font-weight:700;font-size:15px;
    padding:16px 30px;border-radius:8px;transition:transform .2s, filter .2s;
    display:inline-block;
  }
  .btn-primary:hover{transform:translateY(-2px);filter:brightness(1.06);}
  .btn-ghost{
    background:transparent;color:var(--blue);font-weight:700;font-size:15px;
    padding:16px 30px;border-radius:8px;border:1.5px solid var(--blue);
    transition:background .2s,color .2s;display:inline-block;
  }
  .btn-ghost:hover{background:var(--blue);color:#fff;}
  .hero .btn-ghost{color:#fff;border-color:#fff;}
  .hero .btn-ghost:hover{background:#fff;color:var(--blue-ink);}

  .search-card{
    background:#fff;border-radius:20px;
    box-shadow:0 30px 60px -20px rgba(6,42,82,0.28);
    margin-top:-96px;padding:26px;position:relative;z-index:10;
  }
  .search-grid{
    display:grid;grid-template-columns:repeat(6,1fr);gap:14px;align-items:end;
  }
  .field label{
    display:block;font-size:11.5px;font-weight:700;text-transform:uppercase;
    letter-spacing:0.06em;color:#5a6675;margin-bottom:6px;
  }
  .field select, .field input{
    width:100%;padding:11px 12px;border:1.5px solid #e3e8ee;border-radius:10px;
    font-size:14px;font-family:inherit;color:var(--ink);background:#fbfcfe;
    transition:border-color .2s;
  }
  .field select:focus, .field input:focus{outline:none;border-color:var(--blue);}
  .btn-search{
    background:var(--orange);color:#fff;font-weight:700;font-size:14.5px;
    padding:12px 20px;border-radius:10px;width:100%;transition:filter .2s;
  }
  .btn-search:hover{filter:brightness(1.08);}

  .section{padding:96px 0;}
  .section.gray{background:var(--gray);}
  .section-head{max-width:640px;margin-bottom:44px;}
  .section-head h2{font-size:clamp(26px,3.2vw,36px);color:var(--blue-ink);margin-top:10px;}
  .section-head p{margin-top:14px;color:#54606f;font-size:15.5px;}
  .section-head.center{margin-left:auto;margin-right:auto;text-align:center;}

  .results-bar{
    display:flex;justify-content:space-between;align-items:center;
    margin-bottom:24px;flex-wrap:wrap;gap:10px;
  }
  .results-bar .count{font-weight:700;color:var(--blue-ink);}
  .results-bar .count span{color:var(--orange);}

  .grid-biens{
    display:grid;grid-template-columns:repeat(3,1fr);gap:28px;
  }
  .card-bien{
    background:#fff;border-radius:16px;overflow:hidden;
    box-shadow:0 2px 14px rgba(10,20,40,.09);
    transition:transform .3s ease, box-shadow .3s ease;
    display:flex;flex-direction:column;cursor:pointer;
  }
  .card-bien:hover{transform:translateY(-8px);box-shadow:0 22px 38px rgba(10,20,40,.16);}
  .card-media{
    position:relative;height:200px;overflow:hidden;
    background-size:cover;background-position:center;
  }
  .card-media-overlay{
    position:absolute;inset:0;
    background:linear-gradient(180deg, rgba(6,42,82,0.10) 0%, rgba(6,42,82,0.45) 100%);
  }
  .media-badge{
    position:absolute;bottom:12px;left:12px;z-index:2;
    width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,0.92);
    display:flex;align-items:center;justify-content:center;font-size:14px;
  }
  .ribbon{
    position:absolute;top:14px;left:14px;z-index:2;
    background:var(--orange);color:#fff;font-size:12px;font-weight:700;
    padding:6px 14px;border-radius:20px;letter-spacing:0.02em;
  }
  .ribbon.alt{background:#222222;}
  .txn-badge{
    position:absolute;top:14px;right:14px;z-index:2;
    background:rgba(10,20,40,.55);color:#fff;font-size:11.5px;font-weight:600;
    padding:5px 12px;border-radius:20px;
  }
  .card-body{padding:22px;flex:1;display:flex;flex-direction:column;}
  .card-type{
    display:flex;align-items:center;gap:6px;color:var(--orange);
    font-size:12.5px;font-weight:700;margin-bottom:8px;
  }
  .card-zone{font-family:'Bricolage Grotesque',sans-serif;font-size:18.5px;font-weight:700;color:var(--ink);margin-bottom:10px;}
  .card-meta{display:flex;gap:10px;margin-bottom:16px;font-size:13px;color:#666;flex-wrap:wrap;}
  .card-price-row{
    display:flex;align-items:center;justify-content:space-between;
    border-top:1px solid #eee;padding-top:16px;margin-top:auto;
  }
  .card-price{
    font-family:'Bricolage Grotesque',sans-serif;font-size:18px;font-weight:700;color:var(--blue);
  }
  .card-titre{font-size:12px;color:#7a8494;margin-top:2px;}
  .btn-detail{
    color:var(--orange);font-weight:700;font-size:14px;display:flex;align-items:center;gap:5px;
  }
  .no-results{
    grid-column:1/-1;text-align:center;padding:60px 20px;color:#7a8494;
  }


  .services-grid{
    display:grid;grid-template-columns:repeat(4,1fr);gap:22px;
  }
  .service-card{
    background:#fff;border-radius:16px;padding:30px 26px;
    transition:transform .25s ease;
  }
  .service-card:hover{transform:translateY(-6px);}
  .service-icon{
    width:52px;height:52px;border-radius:12px;
    display:flex;align-items:center;justify-content:center;
    margin-bottom:18px;
  }
  .service-icon.blue{background:var(--blue);}
  .service-icon.orange{background:var(--orange);}
  .service-icon svg{width:24px;height:24px;color:#fff;}
  .service-card h3{font-size:17.5px;font-family:'Bricolage Grotesque',sans-serif;font-weight:700;color:var(--ink);}
  .service-card p{font-size:14.5px;color:#666;margin-top:8px;line-height:1.6;}

  .simu-box{
    background:linear-gradient(135deg,var(--blue-ink),var(--blue));
    border-radius:24px;padding:48px;color:#fff;
    display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;
  }
  .simu-box h2{color:#fff;}
  .simu-box .section-head p{color:rgba(255,255,255,0.78);}
  .simu-form .field label{color:rgba(255,255,255,0.75);}
  .simu-form .field input{background:rgba(255,255,255,0.08);border-color:rgba(255,255,255,0.2);color:#fff;}
  .simu-form{display:grid;gap:14px;}
  .simu-result{
    background:rgba(255,255,255,0.08);border-radius:16px;padding:24px;
    border:1px solid rgba(255,255,255,0.16);
  }
  .simu-result .row{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid rgba(255,255,255,0.12);font-size:14px;}
  .simu-result .row:last-child{border-bottom:none;}
  .simu-result .row b{font-family:'Bricolage Grotesque',sans-serif;font-size:17px;color:var(--orange);}

  .testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;}
  .testi-card{
    background:var(--gray);border-radius:16px;padding:30px;
  }
  .stars{color:var(--orange);font-size:14px;letter-spacing:2px;margin-bottom:6px;}
  .testi-card p{margin-top:12px;font-size:14.5px;color:#444;font-style:italic;line-height:1.7;}
  .testi-person{display:flex;align-items:center;gap:14px;margin-bottom:4px;}
  .avatar{
    width:48px;height:48px;border-radius:50%;background:var(--blue);color:#fff;
    display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;
  }
  .testi-name{font-weight:700;font-size:15px;}
  .testi-role{font-size:13px;color:#777;}
  .testi-note{
    margin-top:18px;font-size:12.5px;color:#9aa4b0;font-style:italic;
  }

  .cta-band{
    background:var(--blue);color:#fff;border-radius:0;
    padding:80px 24px;display:flex;flex-direction:column;align-items:center;gap:24px;text-align:center;
  }
  .cta-band h2{color:#fff;font-size:clamp(24px,3.2vw,34px);max-width:700px;}
  .cta-band p{color:#dbe6f5;font-size:15.5px;max-width:600px;}
  .cta-band .cta-actions{display:flex;gap:16px;flex-wrap:wrap;justify-content:center;}
  .cta-band .btn-ghost-white{
    background:transparent;color:#fff;font-weight:700;padding:16px 30px;border-radius:8px;
    border:1.5px solid #fff;transition:background .2s,color .2s;
  }
  .cta-band .btn-ghost-white:hover{background:#fff;color:var(--blue);}

  footer{background:#083b78;color:rgba(255,255,255,0.72);padding:70px 0 28px;}
  .footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:36px;}
  .footer-logo-badge{
    display:inline-block;background:#fff;border-radius:14px;padding:10px 16px;margin-bottom:16px;
  }
  .footer-logo{height:40px;display:block;}
  footer h4{color:#fff;font-size:14px;margin-bottom:16px;font-weight:700;}
  footer ul{list-style:none;}
  footer ul li{margin-bottom:10px;font-size:13.5px;}
  footer ul li a:hover{color:#fff;}
  .footer-social{display:inline-flex;align-items:center;gap:8px;}
  .footer-bottom{
    margin-top:50px;padding-top:24px;border-top:1px solid rgba(255,255,255,0.12);
    display:flex;justify-content:space-between;font-size:12.5px;flex-wrap:wrap;gap:10px;
  }
  .newsletter{display:flex;gap:8px;margin-top:6px;}
  .newsletter input{
    flex:1;padding:10px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.2);
    background:rgba(255,255,255,0.06);color:#fff;font-size:13px;
  }
  .newsletter button{
    background:var(--orange);color:#fff;padding:10px 16px;border-radius:8px;font-weight:700;font-size:13px;
  }

  .wa-float{
    position:fixed;bottom:24px;right:24px;z-index:60;
    width:58px;height:58px;border-radius:50%;background:#25D366;
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 10px 26px -8px rgba(0,0,0,0.4);
    transition:transform .2s;
  }
  .wa-float:hover{transform:scale(1.08);}
  .wa-float svg{width:28px;height:28px;fill:#fff;}

  .modal-overlay{
    position:fixed;inset:0;background:rgba(6,42,82,0.55);z-index:100;
    display:none;align-items:center;justify-content:center;padding:20px;
    backdrop-filter:blur(2px);
  }
  .modal-overlay.open{display:flex;}
  .modal{
    background:#fff;border-radius:20px;max-width:560px;width:100%;
    max-height:85vh;overflow-y:auto;padding:32px;position:relative;
  }
  .modal-close{
    position:absolute;top:18px;right:18px;width:34px;height:34px;border-radius:50%;
    background:var(--gray);display:flex;align-items:center;justify-content:center;font-size:18px;
  }
  .modal h3{font-size:24px;color:var(--blue-ink);margin-top:6px;}
  .modal .modal-meta{display:flex;gap:16px;margin:14px 0;flex-wrap:wrap;font-size:13.5px;color:#5a6675;}
  .modal .modal-price{font-family:'Bricolage Grotesque',sans-serif;font-size:28px;color:var(--orange);font-weight:700;margin:10px 0;}
  .modal p.desc{color:#3a4a5c;font-size:14.5px;margin:14px 0;}
  .modal-moratoire{
    background:var(--gray);border-radius:14px;padding:18px;margin-top:16px;
  }
  .modal-moratoire h4{font-size:13.5px;color:var(--blue-ink);margin-bottom:10px;}
  .modal-moratoire .row{display:flex;justify-content:space-between;font-size:13.5px;padding:5px 0;}
  .modal-actions{display:flex;gap:10px;margin-top:22px;}
  .modal-actions .btn-primary, .modal-actions .btn-ghost{flex:1;text-align:center;font-size:14px;padding:13px;}

  @media (max-width:960px){
    .hero-inner{grid-template-columns:1fr;}
    .grid-biens{grid-template-columns:repeat(2,1fr);}
    .services-grid{grid-template-columns:repeat(2,1fr);}
    .testi-grid{grid-template-columns:1fr;}
    .footer-grid{grid-template-columns:1fr 1fr;}
    .simu-box{grid-template-columns:1fr;padding:32px;}
    .search-grid{grid-template-columns:repeat(3,1fr);}
  }
  @media (max-width:720px){
    .topbar-left span:nth-child(3),.topbar-left span:nth-child(4){display:none;}
    nav.main-menu{
      position:fixed;top:0;right:-100%;height:100vh;width:280px;background:#fff;
      flex-direction:column;padding:90px 28px;box-shadow:-10px 0 40px rgba(0,0,0,0.12);
      transition:right .3s;gap:22px;
    }
    nav.main-menu.open{right:0;}
    .burger{display:block;}
    .btn-rdv{display:none;}
    .grid-biens{grid-template-columns:1fr;}
    .services-grid{grid-template-columns:1fr;}
    .search-grid{grid-template-columns:repeat(2,1fr);}
    .cta-band{flex-direction:column;text-align:center;padding:36px 24px;}
    .footer-grid{grid-template-columns:1fr;}
  }
</style>
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>

<div class="topbar">
  <div class="container">
    <div class="topbar-left">
      <span>Tel : +221 77 000 00 00</span>
      <span>Email : contact@noro-immobilier.sn</span>
      <span>Horaires : Lun-Sam 8h-19h</span>
      <span>WhatsApp : +221 77 000 00 00</span>
    </div>
    <div class="topbar-right">
      <div class="socials">
        <a href="#" aria-label="Facebook">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94z"/></svg>
        </a>
        <a href="#" aria-label="Instagram">
