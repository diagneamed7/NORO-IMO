          <li><a href="#" class="footer-social"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c2.72 0 3.06.01 4.12.06 1.06.05 1.79.22 2.43.47.66.26 1.22.6 1.77 1.15.55.55.89 1.11 1.15 1.77.25.64.42 1.37.47 2.43.05 1.06.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.06-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.15 1.77 4.9 4.9 0 0 1-1.77 1.15c-.64.25-1.37.42-2.43.47-1.06.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.06-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.25-.64-.42-1.37-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.06.22-1.79.47-2.43.26-.66.6-1.22 1.15-1.77A4.9 4.9 0 0 1 5.45 2.53c.64-.25 1.37-.42 2.43-.47C8.94 2.01 9.28 2 12 2zm0 1.8c-2.67 0-2.99.01-4.04.06-.87.04-1.34.18-1.65.3-.42.16-.72.35-1.03.66-.31.31-.5.61-.66 1.03-.12.31-.26.78-.3 1.65C4.27 7.7 4.26 8.02 4.26 10.7v.6c0 2.67.01 2.99.06 4.04.04.87.18 1.34.3 1.65.16.42.35.72.66 1.03.31.31.61.5 1.03.66.31.12.78.26 1.65.3 1.05.05 1.37.06 4.04.06s2.99-.01 4.04-.06c.87-.04 1.34-.18 1.65-.3.42-.16.72-.35 1.03-.66.31-.31.5-.61.66-1.03.12-.31.26-.78.3-1.65.05-1.05.06-1.37.06-4.04s-.01-2.99-.06-4.04c-.04-.87-.18-1.34-.3-1.65a2.77 2.77 0 0 0-.66-1.03 2.77 2.77 0 0 0-1.03-.66c-.31-.12-.78-.26-1.65-.3C14.99 3.81 14.67 3.8 12 3.8zm0 3.06a5.14 5.14 0 1 1 0 10.28A5.14 5.14 0 0 1 12 6.86zm0 1.8a3.34 3.34 0 1 0 0 6.68 3.34 3.34 0 0 0 0-6.68zm5.34-1.98a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z"/></svg> Instagram</a></li>
          <li><a href="#" class="footer-social"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.82c-.9-.98-1.4-2.26-1.4-3.57h-3.05v13.9c0 1.5-1.22 2.72-2.72 2.72a2.72 2.72 0 0 1-1.35-5.08c.42-.24.9-.37 1.4-.37V10.3a5.77 5.77 0 0 0-5.77 5.77 5.77 5.77 0 0 0 11.32 1.63c.15-.5.23-1.03.23-1.58V9.4a7.32 7.32 0 0 0 4.27 1.37V7.72a4.27 4.27 0 0 1-2.93-1.9z"/></svg> TikTok</a></li>
          <li><a href="#" class="footer-social"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.11-2.12C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.39.58A3 3 0 0 0 .5 6.2 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.8 3 3 0 0 0 2.11 2.12C4.5 20.5 12 20.5 12 20.5s7.5 0 9.39-.58a3 3 0 0 0 2.11-2.12A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg> YouTube</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 NORO Immobilier. Tous droits reserves.</span>
      <span>Mentions legales · Politique de confidentialite · CGU</span>
    </div>
  </div>
</footer>

<a href="https://wa.me/221770000000" class="wa-float" aria-label="Contacter sur WhatsApp" target="_blank" rel="noopener">
  <svg viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.9 9.9 0 0 0 4.76 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2zm0 18.02h-.01a8.15 8.15 0 0 1-4.15-1.14l-.3-.18-3.13.82.84-3.05-.2-.31a8.1 8.1 0 0 1-1.24-4.25c0-4.51 3.68-8.19 8.2-8.19 4.51 0 8.19 3.68 8.19 8.2 0 4.51-3.68 8.1-8.2 8.1zm4.5-6.14c-.25-.12-1.45-.72-1.68-.8-.22-.08-.39-.12-.55.13-.16.25-.63.8-.77.96-.14.16-.28.18-.53.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.22-1.46-1.37-1.7-.14-.25-.02-.38.11-.5.11-.11.25-.28.37-.42.12-.14.16-.25.25-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.42-.55-.42h-.47c-.16 0-.42.06-.64.3-.22.25-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.13 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.45-.59 1.65-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.47-.28z"/></svg>
</a>

<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <button class="modal-close" id="modalClose">&#10005;</button>
    <div id="modalContent"></div>
  </div>
</div>

<script>
let PROPERTIES = [];

async function loadProperties(){
  try{
    const res = await fetch('/data/properties.json', {cache: 'no-store'});
    PROPERTIES = await res.json();
  }catch(e){
    console.error('Impossible de charger les biens', e);
    PROPERTIES = [];
  }
}

const fmt = n => n == null ? "Prix sur demande" : n.toLocaleString('fr-FR') + " FCFA";

function zoneList(){
  return [...new Set(PROPERTIES.map(p=>p.zone))].sort();
}

function populateZones(){
  const sel = document.getElementById('fZone');
  zoneList().forEach(z=>{
    const opt = document.createElement('option');
    opt.value = z; opt.textContent = z;
    sel.appendChild(opt);
  });
}

const PHOTO_TERRAIN = "https://images.unsplash.com/photo-1495107334309-fcf20504a5ab?fm=jpg&q=70&w=800&auto=format&fit=crop";
const PHOTO_MAISON = "https://images.unsplash.com/photo-1760473537243-72168ffd273c?fm=jpg&q=70&w=800&auto=format&fit=crop";

function cardHTML(p, idx){
  const statut = p.statut || 'disponible';
  let ribbon;
  if(statut === 'vendu') ribbon = '<span class="ribbon alt">Vendu</span>';
  else if(statut === 'reserve') ribbon = '<span class="ribbon" style="background:#b3261e;">Reserve</span>';
  else ribbon = p.moratoire ? '<span class="ribbon">Moratoire</span>' : '<span class="ribbon alt">Exclusivite</span>';
  const txnBadge = p.moratoire ? 'Vente / Moratoire' : 'Vente';
  const supText = p.superficie ? p.superficie + ' m2' : 'Sur plan';
  const fallbackPhoto = p.type === 'Maison' ? PHOTO_MAISON : PHOTO_TERRAIN;
  const photo = p.photo ? p.photo : fallbackPhoto;
  return `
  <div class="card-bien" data-id="${p.id}" onclick="openModal(${p.id})">
    <div class="card-media" style="background-image:url('${photo}');">
      <div class="card-media-overlay"></div>
      ${ribbon}
      <span class="txn-badge">${txnBadge}</span>
      <span class="media-badge">${p.type === 'Maison' ? '&#127968;' : '&#128506;'}</span>
    </div>
    <div class="card-body">
      <div class="card-type">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
        ${p.zone}
      </div>
      <div class="card-zone">${p.type} · Reference NORO-${String(p.id).padStart(3,'0')}</div>
      <div class="card-meta">
        <span>${p.type}</span><span>·</span><span>${supText}</span><span>·</span><span>${p.titre}</span>
      </div>
      <div class="card-price-row">
        <span class="card-price">${fmt(p.prix)}</span>
        <span class="btn-detail" onclick="event.stopPropagation();openModal(${p.id})">
          Voir le detail
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </div>
    </div>
  </div>`;
}

function render(list){
  const grid = document.getElementById('grilleBiens');
  document.getElementById('resultsCount').innerHTML = `${list.length} bien${list.length>1?'s':''} trouve${list.length>1?'s':''}`;
  if(list.length === 0){
    grid.innerHTML = '<div class="no-results">Aucun bien ne correspond a votre recherche. Essayez d\'elargir vos criteres.</div>';
    return;
  }
  grid.innerHTML = list.map((p,idx)=>cardHTML(p,idx)).join('');
}

function applyFilters(){
  const type = document.getElementById('fType').value;
  const zone = document.getElementById('fZone').value;
  const transaction = document.getElementById('fTransaction').value;
  const min = parseFloat(document.getElementById('fPrixMin').value) || 0;
  const max = parseFloat(document.getElementById('fPrixMax').value) || Infinity;

  const filtered = PROPERTIES.filter(p=>{
    if(type && p.type !== type) return false;
    if(zone && p.zone !== zone) return false;
    if(transaction === 'cash' && p.moratoire) return false;
    if(transaction === 'moratoire' && !p.moratoire) return false;
    if(p.prix != null && (p.prix < min || p.prix > max)) return false;
    return true;
  });
  render(filtered);
}

function openModal(id){
  const p = PROPERTIES.find(x=>x.id===id);
  if(!p) return;
  const statut = p.statut || 'disponible';
  const statutLabel = statut === 'vendu' ? 'Vendu' : statut === 'reserve' ? 'Reserve' : 'Disponible';
  const fallbackPhoto = p.type === 'Maison' ? PHOTO_MAISON : PHOTO_TERRAIN;
  const photo = p.photo ? p.photo : fallbackPhoto;
  let moratoireHTML = '';
  if(p.moratoire){
    moratoireHTML = `
    <div class="modal-moratoire">
      <h4>Formule moratoire disponible</h4>
      <div class="row"><span>Prix moratoire</span><b>${fmt(p.moratoire.prix)}</b></div>
      <div class="row"><span>Acompte</span><b>${fmt(p.moratoire.acompte)}</b></div>
      <div class="row"><span>Mensualite</span><b>${fmt(p.moratoire.mensualite)}</b></div>
      <div class="row"><span>Duree</span><b>${p.moratoire.duree} mois</b></div>
    </div>`;
  }
  document.getElementById('modalContent').innerHTML = `
    <img src="${photo}" alt="${p.zone}" style="width:100%;height:200px;object-fit:cover;border-radius:14px;margin-bottom:16px;">
    <p class="eyebrow">${p.type} · ${p.zone} · ${statutLabel}</p>
    <h3>${p.zone} — Ref. NORO-${String(p.id).padStart(3,'0')}</h3>
    <div class="modal-meta">
      <span>${p.superficie ? p.superficie + ' m2' : 'Superficie sur plan'}</span>
      <span>${p.titre}</span>
    </div>
    <div class="modal-price">${fmt(p.prix)}</div>
    <p class="desc">${p.commentaire}</p>
    ${moratoireHTML}
    <div class="modal-actions">
      <a href="https://wa.me/221770000000" target="_blank" class="btn-primary">Reserver via WhatsApp</a>
      <a href="#contact" class="btn-ghost" onclick="closeModal()">Demande d'info</a>
    </div>
  `;
  document.getElementById('modalOverlay').classList.add('open');
}
function closeModal(){
  document.getElementById('modalOverlay').classList.remove('open');
}
document.getElementById('modalClose').addEventListener('click', closeModal);
document.getElementById('modalOverlay').addEventListener('click', e=>{
  if(e.target.id === 'modalOverlay') closeModal();
});

const CONTACT_CONFIG = {
  rdv: { title: "Prendre rendez-vous", subtitle: "Choisissez un créneau, un conseiller NORO vous confirme le rendez-vous.", showDate: true },
  devis: { title: "Demander un devis", subtitle: "Décrivez votre projet, nous vous envoyons un devis personnalisé.", showDate: false },
  contact: { title: "Nous contacter", subtitle: "Une question ? Écrivez-nous, nous revenons vers vous rapidement.", showDate: false },
};

function openContactModal(type){
  const cfg = CONTACT_CONFIG[type] || CONTACT_CONFIG.contact;
  const dateField = cfg.showDate ? `
    <div class="field" style="margin-bottom:12px;">
      <label>Date souhaitée</label>
      <input type="date" id="ccDate">
    </div>` : '';
  document.getElementById('modalContent').innerHTML = `
    <p class="eyebrow">NORO Immobilier</p>
    <h3>${cfg.title}</h3>
    <p class="desc" style="margin-top:6px;">${cfg.subtitle}</p>
    <div style="margin-top:20px;display:grid;gap:12px;">
      <div class="field"><label>Nom complet</label><input type="text" id="ccNom" placeholder="Votre nom"></div>
      <div class="field"><label>Téléphone / WhatsApp</label><input type="tel" id="ccTel" placeholder="+221 77 000 00 00"></div>
      ${dateField}
      <div class="field"><label>Message</label><input type="text" id="ccMsg" placeholder="Précisez votre besoin (bien, zone, budget...)"></div>
    </div>
    <div id="ccFeedback" style="display:none;margin-top:14px;padding:12px 14px;background:var(--gray);border-radius:10px;font-size:13.5px;color:var(--blue-ink);"></div>
    <div class="modal-actions">
      <button class="btn-primary" style="flex:1;" onclick="submitContactModal('${type}')">Envoyer via WhatsApp</button>
    </div>
  `;
  document.getElementById('modalOverlay').classList.add('open');
}

function submitContactModal(type){
  const nom = document.getElementById('ccNom').value.trim();
  const tel = document.getElementById('ccTel').value.trim();
  const dateEl = document.getElementById('ccDate');
  const date = dateEl ? dateEl.value : '';
  const msg = document.getElementById('ccMsg').value.trim();
  const feedback = document.getElementById('ccFeedback');

  if(!nom || !tel){
    feedback.style.display = 'block';
    feedback.style.color = '#b3261e';
    feedback.textContent = "Merci de renseigner au moins votre nom et votre téléphone.";
    return;
  }

  const cfg = CONTACT_CONFIG[type] || CONTACT_CONFIG.contact;
  let text = `Bonjour NORO Immobilier, je souhaite : ${cfg.title}.
Nom : ${nom}
Téléphone : ${tel}`;
  if(date) text += `
Date souhaitée : ${date}`;
  if(msg) text += `
Message : ${msg}`;

  window.open(`https://wa.me/221770000000?text=${encodeURIComponent(text)}`, '_blank');

  feedback.style.display = 'block';
  feedback.style.color = 'var(--blue-ink)';
  feedback.textContent = "Votre demande a été préparée et ouverte dans WhatsApp. Envoyez le message pour la transmettre à NORO Immobilier.";
}

document.getElementById('btnSearch').addEventListener('click', applyFilters);
['fType','fZone','fTransaction'].forEach(id=>{
  document.getElementById(id).addEventListener('change', applyFilters);
});

const burgerBtn = document.getElementById('burgerBtn');
const mainMenu = document.getElementById('mainMenu');
burgerBtn.addEventListener('click', ()=> mainMenu.classList.toggle('open'));
document.querySelectorAll('#mainMenu a').forEach(a=>{
  a.addEventListener('click', ()=> mainMenu.classList.remove('open'));
});

function updateSimu(){
  const prix = parseFloat(document.getElementById('simuPrix').value) || 0;
  const acompte = parseFloat(document.getElementById('simuAcompte').value) || 0;
  const duree = parseInt(document.getElementById('simuDuree').value) || 1;
  const solde = Math.max(prix - acompte, 0);
  const mensualite = solde / duree;
  const now = new Date();
  now.setMonth(now.getMonth() + duree);
  const fin = now.toLocaleDateString('fr-FR', {year:'numeric', month:'long'});
  document.getElementById('simuSolde').textContent = fmt(Math.round(solde));
  document.getElementById('simuMensualite').textContent = fmt(Math.round(mensualite));
  document.getElementById('simuFin').textContent = fin;
}
['simuPrix','simuAcompte','simuDuree'].forEach(id=>{
  document.getElementById(id).addEventListener('input', updateSimu);
});

async function init(){
  await loadProperties();
  populateZones();
  render(PROPERTIES);
  updateSimu();
}
init();
</script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", user => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
</body>
</html>
